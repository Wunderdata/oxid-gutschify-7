{
    "name": "gutschify/oxid-module",
    "description": "OXID eShop module for displaying Gutschify embedded home page as a configurable widget",
    "type": "oxideshop-module",
    "keywords": [
        "oxid",
        "modules",
        "eShop",
        "gutschify",
        "widget"
    ],
    "homepage": "https://gutschify.xxiii.tools",
    "license": "MIT",
    "authors": [
        {
            "name": "Gutschify Team",
            "email": "support@gutschify.xxiii.tools"
        }
    ],
    "require": {
        "php": ">=8.0",
        "oxid-esales/oxideshop-ce": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/cache": "^5.4 || ^6.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Gutschify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gutschify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "oxideshop": {
            "target-directory": "gutschify"
        }
    }
}
